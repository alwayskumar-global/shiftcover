# Placeholders only. Copy to .env (gitignored) and fill locally. Never commit real values.

# --- App ---
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
DEMO_MODE=false

# --- Database (Supabase Postgres only; PLAN.md 6A) ---
# Supabase SESSION pooler string from Dashboard > Connect > Session pooler (port 5432, host *.pooler.supabase.com,
# user postgres.<project-ref>). NEVER port 6543 (transaction pooler). Percent-encode special chars in the password.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@<aws-region>.pooler.supabase.com:5432/postgres

# --- Secrets (server only) ---
SESSION_SECRET=replace-with-32+-random-chars
CLAIM_TOKEN_PEPPER=replace-with-32+-random-chars

# --- Payments (M1) ---
# paypal | stub. stub fakes payment authorization for local/dev ONLY and is rejected when NODE_ENV=production.
PAYMENTS_MODE=paypal
# Worker offer-link lifetime in seconds (PLAN.md 2: 15 min).
OFFER_TTL_SECONDS=900

# --- PayPal (sandbox only) ---
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLATFORM_EMAIL=

# --- LLM (Gemini; server only) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_ENABLED=true
LLM_MAX_OUTPUT_TOKENS=1024
LLM_DAILY_CALL_CAP=500
LLM_PER_USER_HOURLY_CAP=20

# --- Web Push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email (optional; Outbox covers demo) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Business config ---
WAVE_INTERVAL_SECONDS=300
PLATFORM_FEE_BPS=500
MAX_PREMIUM_PCT_DEFAULT=20

# --- Spike scripts only (scripts/spike-paypal.ts) ---
# Sandbox personal account that receives the spike payout. Must differ from PAYPAL_PLATFORM_EMAIL.
SPIKE_WORKER_EMAIL=

# --- Seed script only (npm run seed). Never commit a real value. ---
# Demo manager password (>= 12 characters). Read from the environment by scripts/seed.ts.
SEED_MANAGER_PASSWORD=
