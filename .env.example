# Placeholders only. Copy to .env (gitignored) and fill locally. Never commit real values.

# --- App ---
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
DEMO_MODE=false

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shiftcover

# --- Secrets (server only) ---
SESSION_SECRET=replace-with-32+-random-chars
CLAIM_TOKEN_PEPPER=replace-with-32+-random-chars

# --- PayPal (sandbox only) ---
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLATFORM_EMAIL=

# --- LLM (Gemini; server only) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_ENABLED=true
LLM_MAX_OUTPUT_TOKENS=1024
LLM_DAILY_CALL_CAP=500
LLM_PER_USER_HOURLY_CAP=20

# --- Web Push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email (optional; Outbox covers demo) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Business config ---
WAVE_INTERVAL_SECONDS=300
PLATFORM_FEE_BPS=500
MAX_PREMIUM_PCT_DEFAULT=20
