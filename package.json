{
  "name": "shiftcover",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "ShiftCover Pay: fill shift gaps fast, guarantee pay, pay on approval.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
